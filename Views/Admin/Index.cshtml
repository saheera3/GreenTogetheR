@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <h2 class="text-success fw-bold mb-4 text-center">
        <i class="fas fa-user-shield me-2"></i>GreenTogether Admin Dashboard
    </h2>
    <p class="text-center text-muted mb-5">
        Manage and monitor all GreenTogether activities efficiently
    </p>

    <div class="row g-4 justify-content-center">

        <!-- Awareness Articles -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-body text-center" style="background-color:#E8F5E9;">
                    <i class="fas fa-newspaper fa-3x text-success mb-3"></i>
                    <h5 class="card-title fw-bold text-success">Awareness Articles</h5>
                    <p class="card-text text-muted small">Create and manage educational content for users.</p>
                    <a href="/Admin/AdminAwarenessArticles/Index" class="btn-green">
                        <i class="fas fa-edit me-1"></i> Manage
                    </a>
                </div>
            </div>
        </div>

        <!-- Recycling Centers -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-body text-center" style="background-color:#E8F5E9;">
                    <i class="fas fa-recycle fa-3x text-success mb-3"></i>
                    <h5 class="card-title fw-bold text-success">Recycling Centers</h5>
                    <p class="card-text text-muted small">Add or update recycling center information.</p>
                    <a href="/Admin/AdminRecylingCenters/Index" class="btn-green">
                        <i class="fas fa-edit me-1"></i> Manage
                    </a>
                </div>
            </div>
        </div>

        <!-- Waste Schedules -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-body text-center" style="background-color:#E8F5E9;">
                    <i class="fas fa-calendar-alt fa-3x text-success mb-3"></i>
                    <h5 class="card-title fw-bold text-success">Waste Schedules</h5>
                    <p class="card-text text-muted small">Organize and maintain waste collection schedules.</p>
                    <a href="/Admin/AdminWasteSchedules/Index" class="btn-green">
                        <i class="fas fa-edit me-1"></i> Manage
                    </a>
                </div>
            </div>
        </div>

        <!-- Registered Users -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-body text-center" style="background-color:#E8F5E9;">
                    <i class="fas fa-users fa-3x text-success mb-3"></i>
                    <h5 class="card-title fw-bold text-success">Registered Users</h5>
                    <p class="card-text text-muted small">View and manage all user profiles.</p>
                    <a href="/Admin/AdminRegisteredUsers/Index" class="btn-green">
                        <i class="fas fa-edit me-1"></i> Manage
                    </a>
                </div>
            </div>
        </div>

        <!-- Illegal Dump Reports -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-body text-center" style="background-color:#E8F5E9;">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                    <h5 class="card-title fw-bold text-danger">Illegal Reports</h5>
                    <p class="card-text text-muted small">View and take actions on illegal dumping reports.</p>
                    <a href="/Admin/AdminIllegalDumpReports/Index" class="btn btn-danger btn-sm w-75">
                        <i class="fas fa-eye me-1"></i> View
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
