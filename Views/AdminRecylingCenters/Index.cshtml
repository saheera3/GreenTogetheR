@model IEnumerable<GreenTogetheR.Models.RecylingCenter>

@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="fas fa-recycle me-2"></i> Recycling Centers
            </h4>
            <a asp-action="Create" class="btn btn-light btn-sm">
                <i class="fas fa-plus-circle"></i> Add New Center
            </a>
        </div>

        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                    <h5>No recycling centers found.</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-success">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.CenterName)</th>
                                <th>@Html.DisplayNameFor(model => model.CenterAddress)</th>
                                <th>@Html.DisplayNameFor(model => model.ContactInfo)</th>
                                <th>City</th>
                                <th style="width:160px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CenterName</td>
                                    <td class="text-truncate" style="max-width: 250px;">@item.CenterAddress</td>
                                    <td>@item.ContactInfo</td>
                                    <td>@item.City?.CityName</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.CenterId"
                                           class="btn btn-outline-primary btn-sm me-1" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.CenterId"
                                           class="btn btn-outline-info btn-sm me-1" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.CenterId"
                                           class="btn btn-outline-danger btn-sm" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

