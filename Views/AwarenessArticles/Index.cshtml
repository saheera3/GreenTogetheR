@using Microsoft.IdentityModel.Tokens
@model IEnumerable<GreenTogetheR.Models.AwarenessArticles>

@{
    ViewData["Title"] = "Awareness Articles";
}
<link rel="stylesheet" href="~/css/site.css" />
<div class="container mt-4">
    <h2 class="mb-4 justify-content-around">Awareness Articles</h2>
    <div class="row justify-content-center">
        @foreach (var article in Model.Take(2)) 
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100" style="height:420px;">
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold">@article.ArticleTitle</h5>
                        <p class="card-text text-muted">@article.ArticleDescription</p>

                        <div class="ratio ratio-16x9 mt-3">
                            <iframe width="100" height="250" src="@article.FileUrl"
                                    title="@article.ArticleTitle" frameborder="0"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen>
                            </iframe>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

   
    <div class="row justify-content-center mt-3">
        @foreach (var article in Model.Skip(2).Take(2)) 
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100" style="height:420px;">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title fw-bold justify-content-center">@article.ArticleTitle</h5>
                            <img src="@article.FileUrl" class="card-img-top"
                                 alt="@article.ArticleTitle" style="height:250px; width:100%; object-fit:contain;" />

                            <p class="card-text text-muted" style="white-space: pre-line;">@article.ArticleDescription</p>
                   
                    
                    
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

