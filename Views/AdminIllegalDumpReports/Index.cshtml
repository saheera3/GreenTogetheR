@model IEnumerable<GreenTogetheR.Models.IllegalDumpReport>

@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="fas fa-dumpster me-2"></i> Illegal Dump Reports
            </h4>
            <div>
                <a asp-action="DownloadPdf" class="btn btn-light btn-sm me-2">
                    <i class="fas fa-file-pdf text-danger"></i> Download PDF
                </a>
            </div>
        </div>

        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                    <h5>No illegal dump reports found.</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-success">
                            <tr>
                                <th>Photo</th>
                                <th>@Html.DisplayNameFor(model => model.Description)</th>
                                <th>@Html.DisplayNameFor(model => model.ReporterName)</th>
                                <th>@Html.DisplayNameFor(model => model.ReportDate)</th>
                                <th>@Html.DisplayNameFor(model => model.Location)</th>
                                <th>@Html.DisplayNameFor(model => model.City)</th>
                                <th>@Html.DisplayNameFor(model => model.User)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PhotoUrl))
                                        {
                                            <img src="@item.PhotoUrl" alt="Dump Photo" width="70" height="70" class="rounded shadow-sm" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Image</span>
                                        }
                                    </td>
                                    <td class="text-truncate" style="max-width: 200px;">@item.Description</td>
                                    <td>@item.ReporterName</td>
                                    <td>@item.ReportDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.Location</td>
                                    <td>@item.City?.CityName</td>
                                    <td>@item.User?.FullName</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.ReportId"
                                           class="btn btn-outline-info btn-sm" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>