@model GreenTogetheR.Models.RegisteredUser


@{
    ViewData["Title"] = "Login Page";
}
@if(TempData["SuccessMessage"] != null)
{
    <script>
        alert('@TempData["SuccessMessage"]');
    </script>
}
<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card p-4 shadow-sm" style="width: 100%; max-width: 400px;">
        <h3 class="text-center mb-4 text-success">Login</h3>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-info text-center">@ViewBag.Message</div>
        }

        <form asp-controller="RegisteredUser" asp-action="Login" method="post">
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">Username</label>
                <input asp-for="UserName" class="form-control" placeholder="Enter your username" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn-green w-100">Login</button>
            </div>
        </form>

        <div class="mt-3 text-center">
            <p>
                Don't have an account?
                <a asp-controller="RegisteredUser" asp-action="Signup" class="text-success fw-bold">Sign up</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

