@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
   
     <link rel="stylesheet" href="~/css/site.css" />
    
}

<div class="container-fluid p-0">
    <img src="~/images/home-banner.jpg" alt="Recycling awareness banner" class="home-image" />

    <div class="d-flex justify-content-center mt-4">
        <a asp-controller="IllegalDumbReport" asp-action="Index" class="btn-green">Report Illegal Dumping</a>
        <a asp-controller="AwarenessArticles" asp-action="Index" class="btn-green">Learn About Waste Recycling</a>
    </div>
</div>
